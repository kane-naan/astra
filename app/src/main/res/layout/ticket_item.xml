<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    android:background="@drawable/ticket_item_border"
    android:minHeight="140dp"
    android:padding="24dp">

    <ImageView
        android:id="@+id/ticketImage"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ticket_image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/ticketTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="6dp"
        android:textColor="@color/darkGray"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ticketImage"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="サンプルチケットタイトル" />

    <TextView
        android:id="@+id/ticketActor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/darkGray"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/ticketTitle"
        app:layout_constraintTop_toBottomOf="@id/ticketTitle"
        tools:text="出演者名" />

    <TextView
        android:id="@+id/atMark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="\@"
        android:textColor="@color/blueGray"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/ticketActor"
        app:layout_constraintStart_toEndOf="@id/ticketActor"
        app:layout_constraintTop_toTopOf="@id/ticketActor" />

    <TextView
        android:id="@+id/ticketPlace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/blueGray"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/atMark"
        app:layout_constraintStart_toEndOf="@id/atMark"
        app:layout_constraintTop_toTopOf="@id/atMark"
        tools:text="シアター名" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/blueGray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/ticketTitle"
        app:layout_constraintTop_toBottomOf="@id/ticketActor" />

    <TextView
        android:id="@+id/currencyMark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="\u00A5"
        android:textColor="@color/blueGray"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/divider"
        app:layout_constraintTop_toBottomOf="@id/divider" />

    <TextView
        android:id="@+id/ticketPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:textColor="@color/blueGray"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/currencyMark"
        app:layout_constraintStart_toEndOf="@id/currencyMark"
        app:layout_constraintTop_toTopOf="@id/currencyMark"
        tools:text="5,000" />

    <ImageView
        android:id="@+id/ticketBookmark"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/baseline_bookmark_border_24"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:tint="@color/blueGray" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/ticketTags"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="4dp"
        app:chipSpacingVertical="4dp"
        app:layout_constraintEnd_toStartOf="@id/ticketBookmark"
        app:layout_constraintStart_toEndOf="@id/ticketPrice"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:singleLine="false" />

</androidx.constraintlayout.widget.ConstraintLayout>